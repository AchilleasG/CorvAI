# Required for the full Corv experience
DATABASE_URL=postgresql://corv:replace-me@postgres-host:5432/corv
OPENAI_KEY=

# Strongly recommended for every network-accessible deployment
APP_ACCESS_TOKEN=

# Optional model provider and transcription
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Encrypts secrets saved through Corv modules; use Fernet.generate_key()
MODULE_SECRET_KEY=

# Public origin used in remote delegation artifact upload instructions
CORV_PUBLIC_BASE_URL=

# Runtime storage and limits
CORV_CODING_DIR=/var/lib/corv-coding
CORV_MEDIA_DIR=
CORV_LOG_DIR=
CORV_MAX_UPLOAD_SIZE=104857600
TIME_ZONE=UTC

# Compose defaults
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_RESULT_EXPIRES=3600

# Optional Google Calendar integration
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_DELEGATED_USER=
GOOGLE_CALENDAR_DEFAULT_ID=primary
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=Europe/Athens

# Optional Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# Optional alternate/self-hosted geocoder
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
